# ============================================================
# Copy this file to secrets.env (same folder) and fill in values.
# secrets.env is gitignored - NEVER commit it.
# install.ps1 replaces __VAR__ placeholders in config templates.
# ============================================================

# MySQL (mysql MCP server)
MYSQL_PASS=your-mysql-password

# Obsidian Local REST API plugin key (obsidian-mcp-server)
OBSIDIAN_API_KEY=your-obsidian-api-key

# opencode providers (opencode.json uses {env:VAR} interpolation)
MIMO_API_KEY=your-mimo-api-key
ZHIPU_API_KEY=your-zhipu-api-key