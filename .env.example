# ============================================================
# Copy this file to secrets.env (same folder) and fill in real values.
# secrets.env is gitignored - NEVER commit it.
#
# Two kinds of variables live here:
#   1) RENDER   - install.ps1 substitutes them into __VAR__ template
#                 placeholders (hosts, users, db names, passwords).
#   2) RUNTIME  - install.ps1 writes them to your user-level environment;
#                 MCP wrappers and opencode read them at process start.
#
# Nothing in this file may ever appear in a committed template.
# ============================================================

# ------------------------------------------------------------
# RENDER: database endpoints (hostnames are treated as private data)
# ------------------------------------------------------------
MYSQL_HOST=mysql.example.com
MYSQL_DEV_HOST=mysql-dev.example.com
MYSQL_TEST_HOST=mysql-test.example.com
MYSQL_USER=root
MYSQL_DB=your_database

# ------------------------------------------------------------
# RUNTIME: passwords
#   MYSQL_PASS      - read-only `mysql` server
#   MYSQL_DEV_PASS  - `mysql-dev` wrapper  (WRITE + DDL enabled)
#   MYSQL_TEST_PASS - `mysql-test` wrapper (WRITE + DDL enabled)
# ------------------------------------------------------------
MYSQL_PASS=your-mysql-password
MYSQL_DEV_PASS=your-mysql-dev-password
MYSQL_TEST_PASS=your-mysql-test-password

# ------------------------------------------------------------
# RUNTIME: Obsidian Local REST API plugin key (obsidian-mcp-server)
# ------------------------------------------------------------
OBSIDIAN_API_KEY=your-obsidian-api-key

# ------------------------------------------------------------
# RUNTIME: GitHub remote MCP bearer token (DSH streamable-http)
#   Fine-grained PAT with read access to the repos you query is enough.
# ------------------------------------------------------------
GITHUB_MCP_TOKEN=github_pat_your_token

# ------------------------------------------------------------
# RUNTIME: opencode provider keys (referenced as {env:VAR})
# ------------------------------------------------------------
B_AI_API_KEY=your-b-ai-api-key
COMMANDCODE_API_KEY=your-commandcode-api-key
JUSTWORK_API_KEY=your-justwork-api-key
MIMO_API_KEY=your-mimo-api-key
SENSENOVA_API_KEY=your-sensenova-api-key
