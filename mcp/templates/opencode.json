{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-goal-plugin",
    "oh-my-openagent"
  ],
  "mcp": {
    "mysql": {
      "type": "local",
      "command": ["npx.cmd", "-y", "@benborla29/mcp-server-mysql"],
      "enabled": true,
      "environment": {
        "MYSQL_HOST": "mysql.test.xhthome.com",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "{env:MYSQL_PASS}",
        "MYSQL_DB": "xht_scm",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    },
    "mcp-obsidian": {
      "type": "local",
      "command": ["npx.cmd", "-y", "obsidian-mcp-server"],
      "enabled": true,
      "environment": {
        "OBSIDIAN_API_KEY": "{env:OBSIDIAN_API_KEY}",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
        "OBSIDIAN_VERIFY_SSL": "false",
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "warn"
      }
    },
    "gitnexus": {
      "type": "local",
      "command": ["gitnexus.cmd", "mcp"]
    },
    "toolknit": {
      "type": "local",
      "command": ["toolknit.cmd", "mcp", "serve"]
    }
  },
  "provider": {
    "mimo": {
      "models": {
        "mimo-v2-tts": { "name": "" },
        "mimo-v2.5": { "name": "" },
        "mimo-v2.5-pro": { "name": "" }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:MIMO_API_KEY}",
        "baseURL": "https://api.xiaomimimo.com/v1",
        "setCacheKey": true
      }
    },
    "zhipu": {
      "models": {
        "astron-code-latest": { "name": "astron-code-latest" },
        "xopdeepseekv4flash": { "name": "deepseekv4-flash" },
        "xopglm51": { "name": "GLM-5.1" }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:ZHIPU_API_KEY}",
        "baseURL": "https://maas-coding-api.cn-huabei-1.xf-yun.com/v2",
        "setCacheKey": true
      }
    }
  }
}
