// Zed settings.json fragment — merge into ~/.config/zed/settings.json
// (Zed >= 0.163 supports the "mcp" array)
// __VAR__ placeholders are replaced by install.ps1 from secrets.env.
// <USER> is a literal placeholder for your Windows username.
{
  "mcp": [
    {
      "name": "mysql",
      "command": "npx.cmd",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "__MYSQL_HOST__",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "__MYSQL_USER__",
        "MYSQL_PASS": "__MYSQL_PASS__",
        "MYSQL_DB": "__MYSQL_DB__",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    },
    {
      "name": "mysql-dev",
      "command": "C:\\Users\\<USER>\\.mcp\\mysql-dev.cmd"
    },
    {
      "name": "mysql-test",
      "command": "C:\\Users\\<USER>\\.mcp\\mysql-test.cmd"
    },
    {
      "name": "mcp-obsidian",
      "command": "C:\\Users\\<USER>\\.mcp\\mcp-obsidian.cmd"
    },
    {
      "name": "gitnexus",
      "command": "gitnexus.cmd",
      "args": ["mcp"]
    },
    {
      "name": "toolknit",
      "command": "toolknit.cmd",
      "args": ["mcp", "serve"]
    }
  ]
}
