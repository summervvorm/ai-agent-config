{
  "mcpServers": {
    "mysql": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "mysql.test.xhthome.com",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "__MYSQL_PASS__",
        "MYSQL_DB": "xht_scm",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      }
    },
    "mcp-obsidian": {
      "type": "stdio",
      "command": "npx.cmd",
      "args": ["-y", "obsidian-mcp-server"],
      "env": {
        "OBSIDIAN_API_KEY": "__OBSIDIAN_API_KEY__",
        "OBSIDIAN_BASE_URL": "https://127.0.0.1:27124",
        "OBSIDIAN_VERIFY_SSL": "false",
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_LOG_LEVEL": "warn"
      }
    },
    "gitnexus": {
      "type": "stdio",
      "command": "gitnexus.cmd",
      "args": ["mcp"]
    },
    "search-service": {
      "type": "stdio",
      "command": "C:\\Users\\20301\\AppData\\Local\\Programs\\Python\\Python312\\python.exe",
      "args": ["C:\\Users\\20301\\Documents\\trae_projects\\python_search_mcp\\main.py"],
      "env": {}
    }
  }
}
